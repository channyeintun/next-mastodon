{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "next-mastodon",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    // Required by OpenNext: Next's server code is Node-flavoured.
    "nodejs_compat",
    // Makes fetch() to your own hostname go back out through the edge rather
    // than looping inside the isolate. OpenNext requires it, and it is also
    // what keeps /api/proxy's outbound requests behaving like real internet
    // traffic instead of same-worker shortcuts.
    "global_fetch_strictly_public"
  ],
  // Custom domain. The apex is served by the Worker directly, so the zone
  // `mastodon.website` has to be active in this same Cloudflare account —
  // Workers cannot attach a custom domain to a zone it does not hold. Deploying
  // while the zone is missing fails the deploy, so this line and the nameserver
  // cutover at the registrar go together.
  "routes": [
    {
      "pattern": "mastodon.website",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "next-mastodon"
    }
  ],
  "observability": {
    "enabled": true
  }
}
